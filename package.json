{
  "name": "larper",
  "productName": "LARPER",
  "version": "1.0.0",
  "description": "LARPER browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.larper.browser",
    "productName": "LARPER",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "portable": {
      "artifactName": "LARPER.exe"
    }
  }
}